# ============================================================================
# .env.example — Variáveis por aplicação (Coolify / Docker)
# ============================================================================
# Preencha os valores de acordo com o ambiente e copie para cada app no Coolify.
# Build-time = injetada durante o build (não disponível em runtime).
# Runtime    = injetada no container em execução.
# ============================================================================

# ---------------------------
# BANCO DE DADOS (compartilhado)
# ---------------------------
DATABASE_URL="postgresql://user:password@db-host:5432/database"

# ---------------------------
# WEB (Vite + Nginx)
# Build-time: VITE_API_URL é embutido no bundle durante pnpm build
# ---------------------------
VITE_API_URL="https://api.seudominio.com"

# ---------------------------
# API (Fastify)
# Runtime: todas são necessárias no container
# ---------------------------
PORT="3333"
NODE_ENV="production"
API_URL="https://api.seudominio.com"
WEB_URL="https://web.seudominio.com"
JWT_SECRET="uuid-aleatorio-aqui"

# ---------------------------
# WORKER (Fastify + Cron)
# Runtime: todas são necessárias no container
# ---------------------------
PORT="3334"
NODE_ENV="production"
COLLECT_INTERVAL_SECONDS="10"
MAX_BACKOFF_SECONDS="3600"
