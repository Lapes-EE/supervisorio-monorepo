{
  "name": "supervisorio-monorepo",
  "private": true,
  "scripts": {
    "api:generate": "turbo run api:generate",
    "build": "turbo run build",
    "check": "ultracite check",
    "db:down": "docker-compose -f docker-compose-dev.yml down -v",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:reset": "pnpm db:down && pnpm db:up && pnpm db:migrate",
    "db:studio": "turbo run db:studio",
    "db:up": "docker-compose -f docker-compose-dev.yml up -d --wait",
    "dev": "turbo run dev db:studio",
    "fix": "ultracite fix",
    "lint": "pnpm dlx ultracite fix",
    "prepare": "husky",
    "start": "turbo run start",
    "test": "turbo -F @repo/server test -F @repo/worker test",
    "test:estimation": "turbo -F @repo/estimation test",
    "test:server": "turbo -F @repo/server test",
    "test:worker": "turbo -F @repo/worker test",
    "ui": "turbo -F @repo/web ui --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "turbo": "^2.9.6",
    "ultracite": "7.10.6"
  },
  "packageManager": "pnpm@9.4.0",
  "pnpm": {
    "overrides": {
      "@fastify/send@<3.4.3": ">=3.4.3",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "@vitest/coverage-v8": ">=3.2.6",
      "ajv@>=7.0.0 <8.18.0": ">=8.18.0",
      "axios@>=1.0.0 <1.12.0": ">=1.12.0",
      "bn.js@<4.12.3": ">=4.12.3",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "diff@>=6.0.0 <8.0.3": ">=8.0.3",
      "drizzle-orm": ">=0.45.2",
      "esbuild@<=0.24.2": ">=0.25.0",
      "esbuild": "0.25.0",
      "fast-jwt@>=5.0.0 <=6.2.0": ">=6.2.1",
      "fast-uri": ">=3.1.2",
      "form-data": ">=4.0.6",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "js-yaml": ">=4.2.0",
      "lodash@<4.18.0": ">=4.18.0",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "minimatch@^10.0.0": "10.2.3",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "picomatch@4.0.3": "4.0.4",
      "picomatch": "4.0.4",
      "postcss@<8.5.10": ">=8.5.10",
      "qs@>=6.7.0 <=6.14.1": ">=6.14.2",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "seroval@>=0.2.0 <=1.4.0": ">=1.4.1",
      "test-exclude>minimatch": "10.2.3",
      "uuid": ">=8.3.3",
      "validator@<13.15.20": ">=13.15.20",
      "validator@<13.15.22": ">=13.15.22",
      "vite@>=6.0.0 <=6.4.2": "6.4.3",
      "vite@>=7.0.0 <=7.3.4": "7.3.5",
      "vitest": ">=3.2.6",
      "ws": ">=8.21.0",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3"
    }
  }
}
