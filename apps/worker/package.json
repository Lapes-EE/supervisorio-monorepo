{
  "name": "@repo/worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "pnpm env:load tsx watch src/worker.ts",
    "env:load": "dotenv -e ../../.env --",
    "start": "pnpm env:load tsx src/worker.ts",
    "test": "dotenv -e ../../.env.test.local vitest run --coverage",
    "test:db:down": "docker-compose -f ../../docker-compose-test.yml down -v",
    "test:db:reset": "pnpm test:db:down && pnpm test:db:up && pnpm --filter @repo/server db:migrate:test",
    "test:db:up": "docker-compose -f ../../docker-compose-test.yml up -d --wait"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/telemetry": "workspace:*",
    "drizzle-orm": "^0.44.3",
    "fastify": "^5.0.0",
    "node-cron": "^3.0.3",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.0",
    "pino": "^9.4.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^24.0.15",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^8.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
