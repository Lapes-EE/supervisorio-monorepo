{
  "name": "@repo/server",
  "version": "1.0.0",
  "scripts": {
    "build": "tsup src/server.ts && tsc",
    "db:generate": "pnpm env:load drizzle-kit generate",
    "db:migrate": "pnpm env:load drizzle-kit migrate",
    "db:migrate:test": "dotenv -e ../../.env.test.local -- drizzle-kit migrate",
    "db:studio": "pnpm env:load drizzle-kit studio",
    "dev": "pnpm env:load tsx watch src/server.ts",
    "env:load": "dotenv -e ../../.env --",
    "start": "pnpm env:load tsx src/server.ts",
    "test": "dotenv -e ../../.env.test.local vitest run --coverage",
    "test:db:down": "docker-compose -f ../../docker-compose-test.yml down -v",
    "test:db:reset": "pnpm test:db:down && pnpm test:db:up && pnpm db:migrate:test",
    "test:db:up": "docker-compose -f ../../docker-compose-test.yml up -d --wait"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/sse": "0.4.0",
    "@fastify/swagger": "^9.5.1",
    "@repo/db": "workspace:^",
    "@repo/env": "workspace:*",
    "@repo/telemetry": "workspace:^",
    "@scalar/fastify-api-reference": "^1.34.2",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.7.3",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^5.0.2",
    "is-ip": "^5.0.1",
    "postgres": "^3.4.7",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^24.0.15",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^8.0.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@9.4.0"
}
