          "404": {
            "description": "Medidor não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Medidor não encontrado",
                  "type": "object",
                  "properties": { "error": { "type": "string" } },
                  "required": ["error"],
                  "additionalProperties": false
                }
              }
            }
