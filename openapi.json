{
  "openapi": "3.0.3",
  "info": {
    "title": "LAPES - API",
    "description": "API for supervisory control and data acquisition",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/sessions/password": {
      "post": {
        "summary": "Authenticate with e-mail & password",
        "tags": ["Auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string", "minLength": 6 }
                },
                "required": ["username", "password"]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Login realizado, token JWT enviado",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Login realizado, token JWT enviado",
                  "type": "object",
                  "properties": { "token": { "type": "string" } },
                  "required": ["token"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Credenciais inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Credenciais inválidas",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/meters": {
      "post": {
        "summary": "Register a new meter",
        "tags": ["Meters"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "ip": { "type": "string", "minLength": 1 },
                  "issoSerial": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" }
                },
                "required": ["name", "ip", "issoSerial"]
              }
            }
          },
          "required": true
        },
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": {
            "description": "Criação de medidor bem sucedida",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Criação de medidor bem sucedida",
                  "type": "object",
                  "properties": {
                    "createdAt": { "type": "string", "format": "date-time" }
                  },
                  "required": ["createdAt"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado, necessita de login",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Não autorizado, necessita de login",
                  "type": "object",
                  "properties": { "error": { "type": "string" } },
                  "required": ["error"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get all meters",
        "tags": ["Meters"],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "number" },
                      "name": { "type": "string" },
                      "ip": { "type": "string" },
                      "description": {
                        "anyOf": [
                          { "type": "string" },
                          { "nullable": true, "enum": [null] }
                        ]
                      },
                      "issoSerial": { "type": "string" },
                      "enabled": { "type": "boolean" },
                      "health": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": ["healthy", "failing", "cooldown"]
                          },
                          { "nullable": true, "enum": [null] }
                        ]
                      }
                    },
                    "required": ["id", "name", "ip", "issoSerial", "enabled"],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/meter/{id}": {
      "patch": {
        "summary": "Update meter enabled status",
        "tags": ["Meters"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "enabled": { "type": "boolean" } },
                "required": ["enabled"]
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "schema": { "type": "number" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Estado do medidor atualizado" },
          "400": { "description": "Falha ao atualizar estado do medidor" },
          "401": {
            "description": "Não autorizado, necessita de login",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Não autorizado, necessita de login",
                  "type": "object",
                  "properties": { "error": { "type": "string" } },
                  "required": ["error"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
