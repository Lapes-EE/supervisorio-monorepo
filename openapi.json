              "application/json": {
                "schema": {
                  "description": "Sucesso",
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado, necessita de login",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Não autorizado, necessita de login",
                  "type": "object",
                  "properties": { "error": { "type": "string" } },
                  "required": ["error"],
                  "additionalProperties": false
                }
              }
            }
