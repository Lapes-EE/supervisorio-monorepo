    "/telemetry": {
      "get": {
        "summary": "Obtain time telemetry data",
        "tags": ["Telemetry"],
        "description": "Search for measurements with temporal filters",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": true,
              "maximum": 9007199254740991,
              "minimum": 0
            },
            "in": "query",
            "name": "meterId",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "in": "query",
            "name": "startDate",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "in": "query",
            "name": "endDate",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "last_5_minutes",
                "last_30_minutes",
                "last_hour",
                "last_6_hours",
                "last_12_hours",
                "last_24_hours",
                "today",
                "last_7_days",
                "this_month",
                "last_30_days",
                "this_year",
                "last_measurement"
              ]
            },
            "in": "query",
            "name": "period",
            "required": false
          },
          {
            "schema": {
              "default": "raw",
              "type": "string",
              "enum": [
                "raw",
                "30 seconds",
                "1 minute",
                "2 minute",
                "5 minute",
                "10 minute",
                "20 minute",
                "30 minute",
                "1 hour",
                "3 hours",
                "1 day"
              ]
            },
            "in": "query",
            "name": "aggregation",
            "required": false
          },
          {
            "schema": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "tensaoFaseNeutroA",
                      "tensaoFaseNeutroB",
                      "tensaoFaseNeutroC",
                      "tensaoFaseFaseAB",
                      "tensaoFaseFaseBC",
                      "tensaoFaseFaseCA",
                      "frequencia",
                      "correnteA",
                      "correnteB",
                      "correnteC",
                      "correnteNeutroMedido",
                      "correnteNeutroCalculado",
                      "potenciaAparenteA",
                      "potenciaAparenteB",
                      "potenciaAparenteC",
                      "potenciaAparenteTotalAritmetica",
                      "potenciaAparenteTotalVetorial",
                      "potenciaAtivaFundamentalA",
                      "potenciaAtivaHarmonicaA",
                      "potenciaAtivaFundamentalHarmonicaA",
                      "potenciaAtivaFundamentalB",
                      "potenciaAtivaHarmonicaB",
                      "potenciaAtivaFundamentalHarmonicaB",
                      "potenciaAtivaFundamentalC",
                      "potenciaAtivaHarmonicaC",
                      "potenciaAtivaFundamentalHarmonicaC",
                      "potenciaAtivaFundamentalTotal",
                      "potenciaAtivaHarmonicaTotal",
                      "potenciaAtivaFundamentalHarmonicaTotal",
                      "potenciaReativaA",
                      "potenciaReativaB",
                      "potenciaReativaC",
                      "potenciaReativaTotalAritmetica",
                      "potenciaReativaTotalVetorial",
                      "anguloFaseA",
                      "anguloFaseB",
                      "anguloFaseC",
                      "phiFaseA",
                      "phiFaseB",
                      "phiFaseC",
                      "fpRealFaseA",
                      "fpRealFaseB",
                      "fpRealFaseC",
                      "fpRealTotalAritmetica",
                      "fpRealTotalVetorial",
                      "fpDeslocamentoFaseA",
                      "fpDeslocamentoFaseB",
                      "fpDeslocamentoFaseC",
                      "fpDeslocamentoTotal",
                      "thdTensaoA",
                      "thdTensaoB",
                      "thdTensaoC",
                      "thdCorrenteA",
                      "thdCorrenteB",
                      "thdCorrenteC",
                      "temperaturaSensorInterno"
                    ]
                  }
                }
              ]
            },
            "in": "query",
            "name": "fields",
            "required": false,
            "description": "Campos específicos para retornar. Se não informado, retorna todos."
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "number" },
                          "meterId": { "type": "number" },
                          "time": { "type": "string" },
                          "tensaoFaseNeutroA": {
                            "anyOf": [
                              { "type": "number" },
                              { "nullable": true, "enum": [null] }
                            ]
                          },
                          "tensaoFaseNeutroB": {
                            "anyOf": [
