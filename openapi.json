      "delete": {
        "summary": "Delete a meter",
        "tags": ["Meters"],
        "parameters": [
          {
            "schema": { "type": "number" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
