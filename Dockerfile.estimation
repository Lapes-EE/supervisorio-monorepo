FROM python:3.14-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Install uv
RUN pip install --no-cache-dir uv

# Cache dependencies
COPY apps/estimation/pyproject.toml apps/estimation/uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

# Copy application source code
COPY apps/estimation/src ./src

# Sync project
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 3010

CMD ["fastapi", "run", "src/api/main.py", "--port", "3010", "--host", "0.0.0.0"]
